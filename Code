local optimizationStates = {
    Shadows = true,
    Atmosphere = true,
    Effects = true,
}
local originalLighting = {
    GlobalShadows = Lighting.GlobalShadows,
    Brightness = Lighting.Brightness,
}
local function setOptimization(key, enabled)
    optimizationStates[key] = enabled
    if key == "Shadows" then
        Lighting.GlobalShadows = enabled
    elseif key == "Atmosphere" then
        Lighting.Brightness = enabled and originalLighting.Brightness or 1
    elseif key == "Effects" then
        for _, object in ipairs(Lighting:GetChildren()) do
            if object:IsA("PostEffect") then object.Enabled = enabled end
        end
    end
end

