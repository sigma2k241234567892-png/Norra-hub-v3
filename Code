            local name = nameInput.Text:gsub("^%s+", ""):gsub("%s+$", "")
            local url = urlInput.Text:gsub("^%s+", ""):gsub("%s+$", "")
            local category = categoryInput.Text:gsub("^%s+", ""):gsub("%s+$", "")
            if #name < 2 or #name > 48 then
                notify("Tên script phải dài 2–48 ký tự.", COLORS.Warning)
                return
            end
            if not url:match("^https?://") then
                notify("URL phải bắt đầu bằng http:// hoặc https://.", COLORS.Warning)
                return
            end
            for _, item in ipairs(Scripts) do
                if string.lower(item.name) == string.lower(name) then
                    notify("Tên script này đã tồn tại.", COLORS.Warning)
                    return
                end
            end
            table.insert(Scripts, {
                name = name,
                category = category ~= "" and category:sub(1, 32) or "Khác",
                description = "Script do người dùng thêm.",
                url = url,
                custom = true,
            })
            local saved = saveCustomScripts()
            nameInput.Text, urlInput.Text, categoryInput.Text = "", "", ""
