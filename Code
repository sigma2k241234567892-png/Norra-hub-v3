local function launchScript(item)
    if not item.url or item.url == "" then
        addHistory(item.name, false)
        notify("Chưa có URL cho " .. item.name .. ". Mở Quản lý script để thêm URL.", COLORS.Warning)
        return
    end
    if type(loadstring) ~= "function" then
        addHistory(item.name, false)
        notify("Executor hiện tại không hỗ trợ loadstring.", COLORS.Warning)
        return
    end
    if type(game.HttpGet) ~= "function" then
        notify("Không thể tải nội dung script từ URL.", COLORS.Danger)
        return
    end

    local ok, source = pcall(function()
        return game:HttpGet(item.url)
    end)
    if not ok or type(source) ~= "string" or source == "" then
        addHistory(item.name, false)
        notify("Tải script thất bại: " .. item.name, COLORS.Danger)
        return
    end
    local compileOk, compiled = pcall(loadstring, source)
    if not compileOk or type(compiled) ~= "function" then
        addHistory(item.name, false)
        notify("Không biên dịch được script: " .. item.name, COLORS.Danger)
        return
    end
    local runOk, runError = pcall(compiled)
    if not runOk then
        addHistory(item.name, false)
        warn("[NORRA HUB] " .. item.name .. ": " .. tostring(runError))
        notify("Script gặp lỗi khi chạy. Xem console để biết chi tiết.", COLORS.Danger)
        return
    end
    addHistory(item.name, true)
    notify("Đã gọi script: " .. item.name, COLORS.Success)
end

