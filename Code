local function safeCall(fn, ...)
    if type(fn) ~= "function" then return false, "Không được executor hỗ trợ." end
    return pcall(fn, ...)
end

local function readJsonFile(fileName)
    if type(isfile) ~= "function" or type(readfile) ~= "function" then return nil end
    local existsOk, exists = pcall(isfile, fileName)
    if not existsOk or not exists then return nil end
    local readOk, raw = pcall(readfile, fileName)
    if not readOk or type(raw) ~= "string" or raw == "" then return nil end
    local decodeOk, decoded = pcall(function()
        return game:GetService("HttpService"):JSONDecode(raw)
    end)
    if decodeOk then return decoded end
    return nil
end

local function writeJsonFile(fileName, data)
    if type(writefile) ~= "function" then return false end
    local encodeOk, encoded = pcall(function()
        return game:GetService("HttpService"):JSONEncode(data)
    end)
    if not encodeOk then return false end
    local writeOk = pcall(writefile, fileName, encoded)
    return writeOk
end

local function loadCustomScripts()
    local saved = readJsonFile(CUSTOM_SCRIPTS_FILE)
    if type(saved) ~= "table" then return end
    local known = {}
    for _, item in ipairs(Scripts) do known[item.name] = true end
    for _, item in ipairs(saved) do
        if type(item) == "table"
            and type(item.name) == "string"
            and item.name ~= ""
            and type(item.url) == "string"
            and item.url:match("^https?://")
            and not known[item.name] then
            table.insert(Scripts, {
                name = item.name:sub(1, 48),
                category = (type(item.category) == "string" and item.category ~= "") and item.category:sub(1, 32) or "Khác",
                description = "Script do người dùng thêm.",
                url = item.url,
                custom = true,
            })
            known[item.name] = true
        end
    end
end
loadCustomScripts()

local function saveCustomScripts()
    local saved = {}
    for _, item in ipairs(Scripts) do
        if item.custom then
            table.insert(saved, {name = item.name, url = item.url, category = item.category})
        end
    end
    return writeJsonFile(CUSTOM_SCRIPTS_FILE, saved)
end

local function loadHistory()
    local saved = readJsonFile(HISTORY_FILE)
    if type(saved) == "table" then return saved end
    return {}
end
local LaunchHistory = loadHistory()

local function addHistory(name, success)
    table.insert(LaunchHistory, 1, {
        name = name,
        time = os.date("%Y-%m-%d %H:%M:%S"),
        success = success == true,
    })
    while #LaunchHistory > MAX_HISTORY do table.remove(LaunchHistory) end
    writeJsonFile(HISTORY_FILE, LaunchHistory)
end

